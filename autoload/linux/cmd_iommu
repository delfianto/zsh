cmd_iommu() {
  # EXTENDED_GLOB is needed for the `#` repetition operator used when trimming.
  setopt LOCAL_OPTIONS EXTENDED_GLOB

  local iommu_rules_file="${XDG_CONFIG_HOME:-$HOME/.config}/iommu_cleanup_rules"

  # Create default rules file if missing
  if [[ ! -f "$iommu_rules_file" ]]; then
    stdout "Cleanup rules file not found. Creating default at $iommu_rules_file"
    cat > "$iommu_rules_file" << 'EOF'
# Cleanup rules for `iommu group`, applied to each device description.
#
# Format:  'text to find'='replacement'
#
# Matching is a plain literal substring replacement, NOT a regex or glob --
# every character is taken as-is. Rules are applied in the order listed, so
# put the specific ones before the general ones.
#
# Trailing PCI revision markers -- " (rev a1)" -- and redundant whitespace are
# stripped automatically; you do not need rules for those.

# Vendor name cleanup
'Advanced Micro Devices, Inc. [AMD]'='AMD'
'NVIDIA Corporation'='NVIDIA'
'Shenzhen Longsys Electronics Co., Ltd.'=''
'Realtek Semiconductor Co., Ltd.'='Realtek'
'ASMedia Technology Inc.'='ASMedia'
'Phison Electronics Corporation'='Phison'
'Qualcomm Technologies, Inc'='Qualcomm'

# Specific device name cleanup
'Raphael/Granite Ridge'='Zen 5'
'Family 19h'='Zen 5'
'600 Series Chipset'='X870E'
'800 Series Chipset'='X870E'
'Technology Inc.'=''
'Corporation'=''
EOF
  fi

  case "$1" in
    'p' | 'pci')
      sudo lspci -vv -s "$2"
      ;;
    'g' | 'group')
      # Parse the rules file once, into two parallel arrays. Doing this per
      # device (and shelling out to cut/sed for each rule) meant hundreds of
      # forks per run.
      local -a rule_pat rule_rep
      local line body

      if [[ -r "$iommu_rules_file" ]]; then
        for line in ${(f)"$(<$iommu_rules_file)"}; do
          # Skip blank lines and comments
          [[ -z "${line//[[:space:]]/}" || "$line" == \#* ]] && continue

          # Split 'original'='replacement' on the quoted separator, so that an
          # `=` inside either half is preserved.
          body="${line#\'}"
          body="${body%\'}"
          rule_pat+=("${body%%\'=\'*}")
          rule_rep+=("${body#*\'=\'}")
        done
      fi

      # Index every PCI device once. `-D` is required: sysfs group members are
      # named with the domain ("0000:01:00.0") and plain `lspci` omits it.
      local -A pci_desc
      for line in ${(f)"$(lspci -D)"}; do
        pci_desc[${line%% *}]="${line#* }"
      done

      local group device pci_id desc i
      for group in /sys/kernel/iommu_groups/*(N/); do
        printf "IOMMU Group %s:\n" "${group:t}"

        for device in "${group}"/devices/*(N); do
          pci_id="${device:t}"
          printf " - %s " "$pci_id"

          desc="${pci_desc[$pci_id]}"
          if [[ -z "$desc" ]]; then
            printf "No device info found\n"
            continue
          fi

          # Drop the device-class prefix ("VGA compatible controller: ")
          desc="${desc#*: }"

          # Apply the cleanup rules literally, in order
          for (( i = 1; i <= ${#rule_pat}; i++ )); do
            desc="${desc//${rule_pat[i]}/${rule_rep[i]}}"
          done

          # Strip a trailing revision marker, then collapse and trim whitespace
          desc="${desc%% \(rev [0-9a-f]##\)}"
          desc="${desc//  ##/ }"
          desc="${desc##[[:space:]]#}"
          desc="${desc%%[[:space:]]#}"

          printf "%s\n" "$desc"
        done

        stdout
      done
      ;;
    'u' | 'usb')
      local usb_ctrl pci_path group_id busnum
      for usb_ctrl in /sys/bus/usb/devices/usb*(N); do
        # :A resolves the symlink, :h takes the parent -- no realpath/dirname forks
        pci_path="${${usb_ctrl:A}:h}"
        group_id="${pci_path}/iommu_group"
        group_id="${group_id:A:t}"
        busnum="$(<$usb_ctrl/busnum)"

        stdout "Bus ${busnum} --> ${pci_path:t} (IOMMU group ${group_id})"
        lsusb -s "${busnum}:"
        stdout
      done
      ;;
    *)
      printf "Usage: %s [pci|group|usb] <pci_id>\n" "${funcstack[1]}"
      printf "  pci|p: Show verbose lspci output for a given device.\n"
      printf "  group|g: List all IOMMU groups and their devices.\n"
      printf "  usb|u: List USB controllers and their IOMMU groups.\n"
      ;;
  esac
}
