cmd_lsenv() {
  # EXTENDED_GLOB is needed for the `#` repetition operator in the ANSI pattern.
  # LC_COLLATE=C keeps the sort order stable regardless of the user's locale.
  setopt LOCAL_OPTIONS EXTENDED_GLOB
  local LC_COLLATE=C

  local pattern="$1"
  local glob_pattern="$pattern"

  # A bare word is treated as a substring match; anything with a `*` is used as-is.
  if [[ -n "$pattern" && "$pattern" != *\** ]]; then
    glob_pattern="*${pattern}*"
  fi

  # Matches a CSI escape sequence, e.g. $'\e[1;32m'.
  local ansi_re=$'\e''\[[0-9;]#[a-zA-Z]'

  local key val found=0

  # Walk $parameters rather than forking `env`: it keeps values with embedded
  # newlines intact and avoids a subshell. The `export` flag in the attribute
  # string is what makes a parameter part of the environment.
  for key in ${(ko)parameters}; do
    [[ ${parameters[$key]} == *export* ]] || continue

    if [[ -n "$pattern" ]] && [[ $key != (#i)${~glob_pattern} ]]; then
      continue
    fi

    found=1
    val="${(P)key}"

    if [[ -z "$val" ]]; then
      printf '%s: [EMPTY]\n' "$key"
    else
      printf '%s: %s\n' "$key" "${val//${~ansi_re}/}"
    fi
  done

  if [[ -n "$pattern" ]] && (( ! found )); then
    stderr "No environment variables match pattern: $pattern"
    return 1
  fi
}
