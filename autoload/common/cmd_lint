cmd_lint() {
  # Syntax-check every shell fragment this repo sources or autoloads. Catches
  # the class of bug this repo has hit before (bad quoting, glob ordering,
  # mismatched case branches) before it lands in an interactive shell.
  local -a files=(
    "${ZDOTDIR}/.zshenv"
    "${ZDOTDIR}/.zshrc"
    "${ZDOTDIR}"/environment/*.env(N.)
    "${ZDOTDIR}"/interactive/*(N.)
    "${ZDOTDIR}"/autoload/**/*(N.)
  )

  local file failed=0
  for file in "${files[@]}"; do
    if ! zsh -n "$file"; then
      stderr "Syntax error in: ${file#${ZDOTDIR}/}"
      failed=1
    fi
  done

  if (( failed )); then
    stderr "lint: failed"
    return 1
  fi

  stdout "lint: ${#files} files OK"
}
