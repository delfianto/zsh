# -*- mode: sh -*-
# Shell initialization script for all platforms

# Names a cmd_* function may take over even though a command already exists.
# The repo ships defaults; $MYCONF/shadow_cmd adds host-specific entries.
local -a shadow_files=(
  "${ZDOTDIR}/shadow_cmd"
  "${ZSH_SHADOW_CMD:-${MYCONF}/shadow_cmd}"
)

local -a shadowed_cmds=()
local shadow_file line

for shadow_file in "${shadow_files[@]}"; do
  [[ -r "${shadow_file}" ]] || continue
  for line in ${(f)"$(<${shadow_file})"}; do
    line="${line//[[:space:]]/}"
    [[ -z "${line}" || "${line}" == \#* ]] && continue
    shadowed_cmds+=("${line}")
  done
done

# Names we wanted but could not claim. Kept around so `checksh` can report them
# instead of the alias just silently not existing.
typeset -ga ZSH_ALIAS_SKIPPED=()

local func_name kebab_name

# Iterate over all defined functions (keys of the 'functions' special associative array)
for func_name in ${(k)functions}; do
  [[ "${func_name}" == cmd_* ]] || continue

  # Convert cmd_snake_case to kebab-case using parameter expansion
  kebab_name="${func_name//_/-}"
  kebab_name="${kebab_name#cmd-}"

  [[ -n "${kebab_name}" && "${kebab_name}" != "${func_name}" ]] || continue

  # Explicitly allowed to take over an existing name
  if (( ${shadowed_cmds[(I)${kebab_name}]} )); then
    (( ZSH_DEBUG_INIT )) && stdout "Shadowing: ${kebab_name} -> ${func_name}"
    alias "${kebab_name}"="${func_name}"
    continue
  fi

  # Refuse to clobber anything that already resolves as a command. has_cmd only
  # looks at $commands (external binaries); `whence -w` covers aliases,
  # functions, builtins and reserved words too. Note that the `$+assoc[key]`
  # form is unusable here: inside (( )) the subscript is math-evaluated, so a
  # key like `fpath` expands to the array's contents instead of being a key.
  if whence -w -- "${kebab_name}" >/dev/null 2>&1; then
    ZSH_ALIAS_SKIPPED+=("${kebab_name} -> ${func_name}")
    (( ZSH_DEBUG_INIT )) &&
      stderr "Skipped: ${kebab_name} -> ${func_name} (name already taken)"
    continue
  fi

  (( ZSH_DEBUG_INIT )) && stdout "Aliased: ${kebab_name} -> ${func_name}"
  alias "${kebab_name}"="${func_name}"
done

# Kitty workaround for remote host without terminfo
# https://wiki.archlinux.org/title/Kitty#Terminal_issues_with_SSH
[[ "$TERM" = "xterm-kitty" ]] && alias ssh="kitty +kitten ssh"

# Command replacements
if has_cmd -q bat; then
  alias cat="bat --color=always --paging=never --style=plain"
  alias nut="bat --color=always --paging=never"
fi

if has_cmd -q duf; then
  alias df="duf"
else
  alias df="df -h"
fi

if has_cmd -q gdu; then
  alias du="gdu"
elif has_cmd -q gdu-go; then
  alias du="gdu-go"
elif has_cmd -q dust; then
  alias du="dust"
else
  alias du="du -h"
  alias ds="du -hs"
fi

if has_cmd -q eza; then
  alias ls="eza ${LS_ARGS}"
  alias ll="eza ${LS_ARGS} -l"
  alias la="eza ${LS_ARGS} -a"
  alias lla="eza ${LS_ARGS} -al"
elif has_cmd -q gls; then
  alias ls="gls ${LS_ARGS}"
  alias ll="gls ${LS_ARGS} -l"
  alias la="gls ${LS_ARGS} -a"
  alias lla="gls ${LS_ARGS} -al"
elif ls --color=auto / &>/dev/null; then
  # GNU ls (Linux or coreutils in PATH without gls symlink)
  alias ls="ls ${LS_ARGS}"
  alias ll="ls ${LS_ARGS} -l"
  alias la="ls ${LS_ARGS} -a"
  alias lla="ls ${LS_ARGS} -al"
else
  # BSD ls (macOS without coreutils)
  alias ls="ls -Gh"
  alias ll="ls -Glh"
  alias la="ls -GAh"
  alias lla="ls -GAlh"
fi

if has_cmd -q nvim; then
  alias vi="nvim"
  alias vim="nvim"
fi

# Rest of command alias
alias cls="clear && printf '\e[3J'"
alias cp="cp -v"
alias mv="mv -v"
alias sudo="sudo "
alias which="command -v"

# Colorful grep output
alias grep="grep -i --color=auto"
alias egrep="egrep -i --color=auto"
alias fgrep="fgrep -i --color=auto"

# Shell management
alias history="fc -li"
alias shdir="cd ${ZDOTDIR}"
alias reload="exec ${SHELL} -l"
