# -*- mode: sh -*-
# File .env.linux; zsh environment config for development tools

export LOCAL_LIB="${LOCAL_LIB:-${HOME}/.local/lib}"
export LOCAL_BIN="${LOCAL_BIN:-${HOME}/.local/bin}"

if has_cmd -q bun; then
  export BUN_INSTALL="$LOCAL_LIB/bun"
  export BUN_INSTALL_BIN="$LOCAL_BIN"
  export BUN_INSTALL_GLOBAL_DIR="$BUN_INSTALL/install"
fi

if has_cmd -q uv; then
  export UV_CACHE_DIR="${UV_CACHE_DIR:-${HOME}/.cache/uv}"
fi

if has_cmd -q direnv; then
  eval "$(direnv hook zsh)"
fi

# SDKMAN (Java/Gradle/Kotlin/etc. version manager).
# Prefer the system-wide install at /opt/sdkman; otherwise fall back to a
# per-user install under $HOME/.local/share/sdkman. A pre-set SDKMAN_DIR
# (e.g. from local.env) wins over both. Sourcing the init script here (in
# .zshenv, via this env file) defines the `sdk` function and prepends the
# selected candidate versions to PATH for non-interactive shells too.
if [[ -z "${SDKMAN_DIR:-}" ]]; then
  if [[ -d /opt/sdkman ]]; then
    export SDKMAN_DIR="/opt/sdkman"
  else
    export SDKMAN_DIR="${HOME}/.local/share/sdkman"
  fi
fi
if [[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]]; then
  source "$SDKMAN_DIR/bin/sdkman-init.sh"
fi

# Vite+ bin (https://viteplus.dev)
if [[ -f "$HOME/.vite-plus/env" ]]; then
  source "$HOME/.vite-plus/env"
fi
