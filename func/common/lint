lint() {
  # Syntax-check every shell fragment this repo sources or autoloads. Catches
  # the class of bug this repo has hit before (bad quoting, glob ordering,
  # mismatched case branches) before it lands in an interactive shell.
  local -a files=(
    "${ZDOTDIR}/.zshenv"
    "${ZDOTDIR}/.zshrc"
    "${ZDOTDIR}/test.zsh"
    "${ZDOTDIR}"/config/**/*.zsh(N.)
    "${ZDOTDIR}"/func/**/*(N.)
  )

  local file failed=0
  for file in "${files[@]}"; do
    if ! zsh -n "$file"; then
      print -r -u2 -- "Syntax error in: ${file#${ZDOTDIR}/}"
      failed=1
    fi
  done

  if (( failed )); then
    print -r -u2 -- "lint: failed"
    return 1
  fi

  print -r -- "lint: ${#files} files OK"

  local python_cache="$XDG_CACHE_HOME/zsh/python"
  local -a python_files=("${ZDOTDIR}"/**/*.py(N.))
  if (( ${#python_files} )); then
    if (( ! ${+commands[python3]} )); then
      print -r -u2 -- "lint: python3 is required for Python utilities"
      return 1
    fi
    local checker
    for checker in ruff basedpyright; do
      if (( ! ${+commands[$checker]} )); then
        print -r -u2 -- "lint: $checker is required for Python checks"
        return 1
      fi
    done
    mkdir -p -- "$python_cache"
    PYTHONPYCACHEPREFIX="$python_cache" \
      command python3 -m py_compile "${python_files[@]}" || return
    command ruff check "${python_files[@]}" || return
    command ruff format --check "${python_files[@]}" || return
    command basedpyright "${python_files[@]}" || return
    print -r -- "lint: ${#python_files} Python files OK (Ruff + BasedPyright)"
  fi

  ZDOTDIR="$ZDOTDIR" zsh -df "$ZDOTDIR/test.zsh"
}
