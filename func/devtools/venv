venv() {
  emulate -L zsh

  if [[ "${1:-}" != load ]]; then
    "$ZDOTDIR/utils/venv_tool.py" "$@"
    return
  fi

  shift
  if (( $# > 1 )); then
    print -r -u2 -- "venv load: expected at most one environment path"
    return 2
  fi

  local environment="${1:-.venv}"
  local activate="$environment/bin/activate"
  if [[ ! -r "$activate" ]]; then
    print -r -u2 -- "venv load: activation script not found: $activate"
    print -r -u2 -- "Tip: create it with 'venv init $environment'"
    return 1
  fi

  source "$activate" || return
  print -r -- "Activated virtual environment: ${VIRTUAL_ENV:-$environment}"
}
