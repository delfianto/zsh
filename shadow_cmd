# Command names that a cmd_* function is allowed to take over even though a
# real command of that name already exists.
#
# By default the auto-aliaser in interactive/common refuses to clobber an
# existing command, which silently disables every wrapper written *because* the
# original exists. List those names here to opt them back in.
#
# One name per line. Blank lines and #-comments are ignored.
# Host-specific additions go in $MYCONF/shadow_cmd (not tracked by git).

# cmd_ex -- archive extractor; shadows /usr/bin/ex (vi in ex-mode)
ex

# cmd_xdg_open -- prefers handlr; shadows /usr/bin/xdg-open
xdg-open

# cmd_jstatd -- starts jstatd with a generated security policy
jstatd
